IS_DEV=true

# Production domains:
#   client SPA:  https://cabinet.vitamin-water.ru/m/{serial}/auth
#   telemetry:   https://tl.vitamin-water.ru
#   marketing:   https://vitamin-water.ru
VITE_APP_URL_FRONT=https://cabinet.vitamin-water.ru
VITE_APP_URL_AUTH=https://cabinet.vitamin-water.ru
VITE_APP_BASE_URL=https://cabinet.vitamin-water.ru/

# Viwa Telemetry client web (auth, profile, billing, public machine lookup)
# Same-origin via nginx proxy on cabinet.vitamin-water.ru — see docs/contracts/loyalty-client-rest.md
# For staging integration against tl.vitamin-water.ru directly, see .env.staging.example
VITE_VIWA_TELEMETRY_API_URL=https://cabinet.vitamin-water.ru/api/v1

VITE_APP_DEFAULT_BOT_NAME=ViwaBot
# Optional: override legacy Telegram bot usernames (without @)
#VITE_APP_TELEGRAM_SUPPORT_BOT=MyShaker_bot
#VITE_APP_TELEGRAM_DEV_ALERT_BOT=ShakerTelemetryAlert_bot
