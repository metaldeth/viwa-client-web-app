IS_DEV=true

# Production domains:
#   client SPA:  https://viwa.asnefedov.ru/m/{serial}/auth
#   telemetry:   https://tl.asnefedov.ru
VITE_APP_URL_FRONT=https://viwa.asnefedov.ru
VITE_APP_URL_AUTH=https://viwa.asnefedov.ru
VITE_APP_BASE_URL=https://viwa.asnefedov.ru/

# Viwa Telemetry client web (auth, profile, billing, public machine lookup)
# Same-origin via nginx proxy on viwa.asnefedov.ru — see docs/contracts/loyalty-client-rest.md
VITE_VIWA_TELEMETRY_API_URL=https://viwa.asnefedov.ru/api/v1

VITE_APP_DEFAULT_BOT_NAME=ViwaBot
# Optional: override legacy Telegram bot usernames (without @)
#VITE_APP_TELEGRAM_SUPPORT_BOT=MyShaker_bot
#VITE_APP_TELEGRAM_DEV_ALERT_BOT=ShakerTelemetryAlert_bot
