# Copy to .env.production (gitignored) for local production builds.
# Deploy/CI MUST set VITE_VIWA_TELEMETRY_API_URL explicitly — npm run build fails without it.
#
# Same-origin via nginx proxy on cabinet.vitamin-water.ru — see docs/contracts/loyalty-client-rest.md

VITE_APP_URL_FRONT=https://cabinet.vitamin-water.ru
VITE_APP_URL_AUTH=https://cabinet.vitamin-water.ru
VITE_APP_BASE_URL=https://cabinet.vitamin-water.ru/

# Required — validated at build time (https, path ends with /api/v1, no localhost)
VITE_VIWA_TELEMETRY_API_URL=https://cabinet.vitamin-water.ru/api/v1

VITE_APP_DEFAULT_BOT_NAME=ViwaBot
