{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "baseUrl": ".",
    "paths": {
      "@consta/uikit": ["node_modules/@asnefedov/uikit"],
      "@consta/uikit/*": ["node_modules/@asnefedov/uikit/*"],
      "@consta/icons": ["node_modules/@asnefedov/icons"],
      "@consta/icons/*": ["node_modules/@asnefedov/icons/*"]
    }
  },
  "include": ["src", "scripts", "custom.d.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**"
  ]
}
