# Staging / local integration against telemetry public API (task-09).
# Copy to .env.staging for `npm run dev` or Vite `--mode staging`.

IS_DEV=true

VITE_APP_URL_FRONT=https://cabinet.vitamin-water.ru
VITE_APP_URL_AUTH=https://cabinet.vitamin-water.ru
VITE_APP_BASE_URL=https://cabinet.vitamin-water.ru/

# Direct staging telemetry API (CORS allowlist includes vitamin-water.ru + cabinet)
VITE_VIWA_TELEMETRY_API_URL=https://tl.vitamin-water.ru/api/v1

VITE_APP_DEFAULT_BOT_NAME=ViwaBot
